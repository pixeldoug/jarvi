{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "jarvi": {
      "type": "streamable-http",
      "url": "https://jarvi-production.up.railway.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["tasks"],
            "resource": "https://jarvi-production.up.railway.app/mcp"
          }
        }
      }
    }
  }
}
