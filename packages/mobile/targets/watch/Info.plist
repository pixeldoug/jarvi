<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the Info.plist Xcode generates. CFBundleDevelopmentRegion
	     cannot be set here (Xcode writes the project's "en"), so a watch in a
	     language other than pt/en shows English, unlike the iPhone app. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>pt</string>
		<string>en</string>
	</array>
	<!-- Speaking a task is the app's main action. Translated in
	     pt.lproj/en.lproj InfoPlist.strings. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>A Jarvi usa o microfone para transformar o que você fala em tarefas.</string>
	<!-- jarviwatch://speak: the complication and the Smart Stack widget
	     (targets/watch-widget) open the app already listening. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jarvi.app.watchkitapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jarviwatch</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
