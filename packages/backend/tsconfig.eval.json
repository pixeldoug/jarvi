{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-eval",
    "noEmit": true
  },
  "include": ["src/**/*", "evals/**/*"],
  "ts-node": {
    // Load `include` (notably src/types/*.d.ts, where the ambient
    // `@posthog/ai/openai` declaration lives) — ts-node ignores it by default.
    "files": true
  }
}
