{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/routes/*": ["src/routes/*"],
      "@/controllers/*": ["src/controllers/*"],
      "@/middleware/*": ["src/middleware/*"],
      "@/database/*": ["src/database/*"],
      "@/types/*": ["../shared/src/types/*"],
      "@/utils/*": ["../shared/src/utils/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    // `npm run dev` runs through ts-node, which ignores `include` by default and
    // therefore never sees src/types/*.d.ts (the ambient `@posthog/ai/openai`
    // declaration). `tsc` and the Railway build are unaffected.
    "files": true
  }
}
